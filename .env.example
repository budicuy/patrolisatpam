# ==========================================
# KONFIGURASI DATABASE (PostgreSQL)
# ==========================================
# Contoh koneksi local PostgreSQL atau cloud database (Neon)
DATABASE_URL="postgresql://username:password@localhost:5432/patrolisatpam?sslmode=disable"

# ==========================================
# AUTHENTICATION (NextAuth.js v5)
# ==========================================
# Generate random secret dengan perintah: openssl rand -base64 32
# atau npx auth secret
AUTH_SECRET="your-32-character-secret-key-here"

# ==========================================
# OBJECT STORAGE (S3 / Cloudflare R2 / Neon Storage / MinIO)
# Digunakan untuk menyimpan bukti foto patroli
# ==========================================
AWS_ENDPOINT_URL_S3="https://your-s3-or-r2-endpoint.com"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="ap-southeast-1"
AWS_BUCKET_NAME="uploads"
